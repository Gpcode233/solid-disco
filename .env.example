# Google Sheets Configuration
# The ID of your Google Sheet (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Service Account email generated in Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# Service Account Private Key (keep quotes around the key, with \n preserved)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
